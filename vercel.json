{
  "version": 2,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/clara",
      "destination": "https://teawithclara.substack.com",
      "permanent": false
    },
    {
      "source": "/tea",
      "destination": "https://teawithclara.substack.com",
      "permanent": false
    },
    {
      "source": "/substack",
      "destination": "https://teawithclara.substack.com",
      "permanent": false
    },
    {
      "source": "/sponsor",
      "destination": "https://www.passionfroot.me/tea-with-clara",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
